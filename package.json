{
  "name": "i-use-nitro-btw",
  "type": "module",
  "scripts": {
    "build": "bunx --bun nitro build",
    "dev": "bunx --bun nitro dev",
    "preview": "bunx --bun srvx --prod .output/",
    "start": "bun run .output/server/index.mjs",
    "format": "oxfmt && oxfmt --check",
    "lint": "oxlint --type-aware",
    "db:generate": "bunx --bun drizzle-kit generate",
    "db:push": "bunx --bun drizzle-kit push",
    "db:pull": "bunx --bun drizzle-kit pull",
    "db:studio": "bunx --bun drizzle-kit studio",
    "db:check": "bunx --bun drizzle-kit check"
  },
  "dependencies": {
    "consola": "^3.4.2",
    "drizzle-orm": "^1.0.0-beta.15-859cf75",
    "drizzle-query-logger": "^1.1.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bun": "^1.3.9",
    "drizzle-kit": "^1.0.0-beta.15-859cf75",
    "nitro": "latest",
    "oxfmt": "^0.27.0",
    "oxlint": "^1.47.0",
    "oxlint-tsgolint": "^0.11.5",
    "rolldown": "latest"
  }
}
